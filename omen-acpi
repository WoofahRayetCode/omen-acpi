}

success() {
    printf '%b%s%b\n' "$GREEN" "$*" "$RESET"
}

section() {
    printf '\n%b%s%b\n' "$ORANGE$BOLD" "$*" "$RESET"
}

sanitize_line() {
    tr -d '\000-\010\013\014\016-\037\177' <<<"${1:-}" | tr -d '\r\n'
}

ensure_user_directories() {
    mkdir -p -- "$ARTIFACT_DIR" "$LOG_DIR" "$USER_STATE_ROOT"
    chmod 0700 "$USER_DATA_ROOT" "$ARTIFACT_DIR" "$LOG_DIR" "$USER_STATE_ROOT"
}

confirm() {
    local prompt="$1"
    local default="${2:-no}"
    local answer suffix

    if (( ASSUME_YES )); then
        printf '%s [automatic yes]\n' "$prompt"
        return 0
    fi
    [[ -t 0 ]] || die "This action needs confirmation. Run it from an interactive terminal."

    if [[ "$default" == "yes" ]]; then
        suffix='[Y/n]'
    else
        suffix='[y/N]'
    fi
    read -r -p "$prompt $suffix " answer
    answer="${answer,,}"
    if [[ -z "$answer" ]]; then
        [[ "$default" == "yes" ]]
        return
    fi
    [[ "$answer" == "y" || "$answer" == "yes" ]]
}

confirm_dangerous() {
    local prompt="$1" default="${2:-no}" saved_assume_yes="$ASSUME_YES" result=1
    ASSUME_YES=0
    if confirm "$prompt" "$default"; then
        result=0
    fi
    ASSUME_YES="$saved_assume_yes"
    return "$result"
}

pause_for_user() {
    [[ -t 0 ]] || return 0
    printf '\n'
    read -r -p 'Press Enter to continue... ' _
}

machine_values() {
    MACHINE_PRODUCT="$(sanitize_line "$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)")"
    MACHINE_BOARD="$(sanitize_line "$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)")"
    MACHINE_BIOS="$(sanitize_line "$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)")"
